# Copy to .env and fill in real values. .env is gitignored.

# Which backend to use: dashscope | ollama
LLM_PROVIDER=dashscope

# Alibaba Cloud Model Studio (DashScope / Qwen), OpenAI-compatible endpoint
DASHSCOPE_BASE_URL=https://ws-z81ddjukrv6vbmhf.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3.8-max

# Local Ollama, OpenAI-compatible endpoint (no API key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b
